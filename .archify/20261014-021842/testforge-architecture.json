  "cards": [
    {
      "dot": "cyan",
      "title": "Architecture & Multi-Service Split",
      "items": [
        "Frontend (Next.js 16 / React 19): Hosts UI, MSBTE reports (F1-F22), dynamic module routing, and executes direct DB queries via Drizzle ORM.",
        "Backend (FastAPI / Python): Offloads CPU-intensive ingestion (HTML timetable & multi-column Excel seating charts) using pandas and BeautifulSoup.",
        "Persistence (PostgreSQL 16): Shared single source of truth queried by Next.js and populated by FastAPI batch operations."
      ]
    },
    {
      "dot": "emerald",
      "title": "Ingestion & Seating Workflow",
      "items": [
        "1. Exam controller uploads timetable HTML / seating Excel in browser (frontend/src/components/shared/file-uploader.tsx).",
        "2. Files stream directly to FastAPI (/api/upload/ and /api/timetable/process) for high-throughput vectorized parsing.",
        "3. Backend validates Better Auth session cookies with Next.js (/api/auth/get-session) via httpx before processing.",
        "4. Parsed and sanitized rows are committed in batches directly to PostgreSQL tables via SQLAlchemy."
      ]
    },
    {
      "dot": "violet",
      "title": "Security & Authentication Bridge",
      "items": [
        "Better Auth Integration: Handles user authentication, email verification, and session persistence in Next.js with Drizzle adapter.",
        "Inter-Service Trust: FastAPI extracts better-auth.session_token cookie and queries Next.js get-session endpoint asynchronously.",
        "Role & Tenant Scoping: Retrieves exam_center_id and org membership from DB on every authenticated backend call."
      ]
    },
    {
      "dot": "rose",
      "title": "External Integrations & Deployment",
      "items": [
        "Resend Email Client: Sends duty assignment orders to exam staff and password verification links with automatic retry policies.",
        "Razorpay Gateway: Manages tiered subscriptions (trial, premium, enterprise lifetime) and validates checkout webhooks.",
        "Container Topology: Orchestrated via docker-compose.yml on private bridge network 'testforge-network' with health checks."
      ]
    }
  ]
